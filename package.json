{
  "name": "crop-image",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-mediapipe-wasm.mjs && vite",
    "build": "npm run wasm:build && npm run build:web",
    "build:web": "node scripts/copy-mediapipe-wasm.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "wasm:build": "wasm-pack build crates/crop-image-wasm --target web --out-dir ../../src/wasm/pkg --release",
    "model:fetch": "node scripts/fetch-model.mjs",
    "setup": "npm run model:fetch && node scripts/copy-mediapipe-wasm.mjs && npm run wasm:build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "fflate": "0.8.3",
    "onnxruntime-web": "1.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vite": "7.1.0"
  }
}
